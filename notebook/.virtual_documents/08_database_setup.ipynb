columns = [
    "genres",
    "main_cast",
    "director",
    "producer",
    "languages",
    "countries",
    "studios",
    "themes"
]

placeholders = [
    "Unknown",
    "N/A",
    "None",
    "-"
]

for col in columns:

    movies[col] = movies[col].replace(placeholders, pd.NA)


for col in columns:

    movies[col] = (
        movies[col]
        .replace(r'^\s*$', pd.NA, regex=True)
    )


movies = movies.dropna(
    subset=["title"]
)


movies.to_csv(
    "../dataset/processed/movieverse_master_dataset.csv",
    index=False
)

print("Final Clean Dataset Saved")
